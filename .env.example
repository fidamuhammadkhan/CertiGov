# Generate each secret independently with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=REPLACE_WITH_A_RANDOM_48_BYTE_SECRET
CERT_SIGNING_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_48_BYTE_SECRET
DATABASE_URL=sqlite:///./certigov.db
DATA_DIR=./data
PUBLIC_BASE_URL=http://127.0.0.1:8000
PRODUCTION=false
# For initialization only. Do not commit real credentials.
# INITIAL_ADMIN_EMAIL=admin@example.org
# INITIAL_ADMIN_NAME=Platform Owner
# INITIAL_ADMIN_PASSWORD=at-least-12-characters

# For free stateless Render hosting, store certificates and images in external PostgreSQL.
# STORAGE_BACKEND=database
# RENDER_EXTERNAL_URL is automatically supplied by Render; do not set PUBLIC_BASE_URL.
